Output demos/claude-code-demo.gif
Set FontSize 14
Set Width 1280
Set Height 720
Set Theme { "name": "monokai", "background": "#0C0C0C" }
Set TypingSpeed 20ms
Set PlaybackSpeed 1.4

Hide
Type "cd /Users/alex/projects/pi_agent_rust && clear"
Enter
Show

Type "echo '╔════════════════════════════════════════════════════════════╗'"
Enter
Type "echo '║  Claude Code Session - Analyzing pi-rust skill            ║'"
Enter
Type "echo '╚════════════════════════════════════════════════════════════╝'"
Enter
Sleep 1s

Type "claude -p 'Analyze pi_terraphim_router module'"
Enter
Sleep 2s

Type "cat /tmp/claude_full_output.txt"
Enter
Sleep 15s

Type "echo '=== Claude Code Analysis Complete ==='"
Enter
Sleep 1s
